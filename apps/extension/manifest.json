{
  "manifest_version": 3,
  "name": "AI Action Browser",
  "version": "0.1.0",
  "description": "A free AI browser side panel for Search, Compare, and Prepare with explicit user confirmation before important handoffs.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "sidePanel"
  ],
  "action": {
    "default_title": "Open AI Action Browser"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
